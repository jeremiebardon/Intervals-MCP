{
  "name": "@intervals/agents",
  "version": "0.0.1",
  "description": "NestJS server: training coach LangGraph agents over intervals.icu, traced with Arize Phoenix",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start:dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --passWithNoTests",
    "fixtures:record": "tsx scripts/record-fixtures.ts"
  },
  "dependencies": {
    "@arizeai/openinference-instrumentation-langchain": "4.1.1",
    "@arizeai/phoenix-otel": "2.2.0",
    "@langchain/core": "^1.2.11",
    "@langchain/langgraph": "^1.4.18",
    "@langchain/langgraph-checkpoint": "^1.1.5",
    "@langchain/ollama": "1.3.0",
    "@nestjs/common": "^11.2.6",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "11.2.3",
    "langchain": "^1.5.11",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.3"
  },
  "devDependencies": {
    "@intervals/tsconfig": "workspace:*",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "^11.2.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.20.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
