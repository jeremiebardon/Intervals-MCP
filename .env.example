# Personal API key from https://intervals.icu -> Settings -> Developer
INTERVALS_API_KEY=
# Athlete id; "0" resolves to the key's own athlete and is almost always correct
INTERVALS_ATHLETE_ID=0

# Where OpenTelemetry spans are sent. http://localhost:6006 is correct for an
# app run on the host (the MCP server) against the Phoenix published by
# docker-compose. The agent container overrides this to http://phoenix:6006,
# its service name on the compose network.
#
# IMPORTANT: each app's instrumentation.ts calls Phoenix's register() as the
# very first import in main.ts, before any .env file is loaded (Nest's
# ConfigModule, dotenv, etc. all load later). Setting this variable in this
# file has NO EFFECT on telemetry registration. To actually change it, export
# it in the real shell environment before starting the process, or set it in
# the `env` block of the MCP client's server config. docker-compose.yml
# already does the equivalent for the agent container.
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# Port the LangGraph agent's HTTP surface listens on
AGENT_PORT=8787
