{
  "name": "intervals-icu-monorepo",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "start:dev": "turbo start:dev --env-mode=loose",
    "lint": "eslint \"{apps,packages}/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"{apps,packages}/**/*.{ts,tsx,css}\"",
    "docker:preprod": "docker compose -f docker-compose.yml --env-file .env.preprod up",
    "docker:prod": "docker compose -f docker-compose.yml --env-file .env.production up"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@next/eslint-plugin-next": "16.3.6",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "^5.2.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.0.0",
    "prettier": "^3.4.2",
    "turbo": "^2.11.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
